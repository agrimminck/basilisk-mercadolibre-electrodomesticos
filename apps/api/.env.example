# Database (Docker: docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/affiliate_gaming

# Amazon PA-API v5
# Get it at: https://affiliate-program.amazon.com/ → Tools → Product Advertising API
AMAZON_ACCESS_KEY=your_access_key_here
AMAZON_SECRET_KEY=your_secret_key_here

# Your Amazon Associates tracking ID (e.g. mysite-20)
AMAZON_PARTNER_TAG=your-tag-20

# Target marketplace (default: www.amazon.com)
AMAZON_MARKETPLACE=www.amazon.com
